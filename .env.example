# Copy to .env.local and fill in. Never commit real values.
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp number orders are sent to: 2547XXXXXXXX (no plus sign, no spaces)
VITE_WHATSAPP_NUMBER=2547XXXXXXXX

# NEVER put the service_role key in this file or anywhere in the frontend.

# Optional: Google Maps Embed API key for the Contact page map.
# Create one in Google Cloud Console (enable "Maps Embed API"), and restrict it
# to HTTP referrers: your domain(s) and http://localhost:5173/*.
# Leave blank to use Google's standard embedded map (no key needed).
VITE_GOOGLE_MAPS_API_KEY=

# Your live domain, with https:// and no trailing slash, e.g. https://mandelaheritage.co.ke
# Used for canonical links, social previews, robots.txt and the XML sitemaps.
# If blank on Vercel, the project's production domain is used for the sitemap.
VITE_SITE_URL=
